{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "OrderPlaced"
  },
  "paths": {},
  "components": {
    "schemas": {
      "AWSEvent": {
        "type": "object",
        "x-amazon-events-detail-type": "Order Placed",
        "x-amazon-events-source": "com.example.orders",
        "required": [
          "detail-type",
          "resources",
          "detail",
          "id",
          "source",
          "time",
          "region",
          "version",
          "account"
        ],
        "properties": {
          "account": { "type": "string" },
          "detail": { "$ref": "#/components/schemas/OrderPlaced" },
          "detail-type": { "type": "string" },
          "id": { "type": "string" },
          "region": { "type": "string" },
          "resources": {
            "type": "array",
            "items": { "type": "string" }
          },
          "source": { "type": "string" },
          "time": { "type": "string", "format": "date-time" },
          "version": { "type": "string" }
        }
      },
      "OrderPlaced": {
        "type": "object",
        "required": [
          "orderId",
          "customerId",
          "currency",
          "totalAmount",
          "placedAt",
          "lines"
        ],
        "properties": {
          "orderId": { "type": "string" },
          "customerId": { "type": "string" },
          "currency": { "type": "string" },
          "totalAmount": { "type": "number", "format": "double" },
          "placedAt": { "type": "string", "format": "date-time" },
          "channel": { "type": "string" },
          "lines": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/OrderLine" }
          }
        }
      },
      "OrderLine": {
        "type": "object",
        "required": ["sku", "quantity", "unitPrice"],
        "properties": {
          "sku": { "type": "string" },
          "quantity": { "type": "integer" },
          "unitPrice": { "type": "number", "format": "double" }
        }
      }
    }
  }
}
