{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "PaymentSettled"
  },
  "paths": {},
  "components": {
    "schemas": {
      "AWSEvent": {
        "type": "object",
        "x-amazon-events-detail-type": "Payment Settled",
        "x-amazon-events-source": "com.example.payments",
        "required": [
          "detail-type",
          "resources",
          "detail",
          "id",
          "source",
          "time",
          "region",
          "version",
          "account"
        ],
        "properties": {
          "account": { "type": "string" },
          "detail": { "$ref": "#/components/schemas/PaymentSettled" },
          "detail-type": { "type": "string" },
          "id": { "type": "string" },
          "region": { "type": "string" },
          "resources": {
            "type": "array",
            "items": { "type": "string" }
          },
          "source": { "type": "string" },
          "time": { "type": "string", "format": "date-time" },
          "version": { "type": "string" }
        }
      },
      "PaymentSettled": {
        "type": "object",
        "required": [
          "paymentId",
          "orderId",
          "currency",
          "settledAmount",
          "settledAt",
          "method"
        ],
        "properties": {
          "paymentId": { "type": "string" },
          "orderId": { "type": "string" },
          "currency": { "type": "string" },
          "settledAmount": { "type": "number", "format": "double" },
          "settledAt": { "type": "string", "format": "date-time" },
          "method": {
            "type": "string",
            "enum": ["card", "bank-transfer", "wallet", "credit-note"]
          },
          "processorReference": { "type": "string" }
        }
      }
    }
  }
}
